'use client';
import {useCallback,useEffect,useRef,useState} from 'react';
import {Coffee,Copy,Users,Monitor,SlidersHorizontal,Check,LogOut,Shuffle,RotateCcw,Play,Pause,Trash2,Hand,Info,Music,VolumeX,MessageCircleQuestion,X} from 'lucide-react';
import {INTERESTS,QUESTIONS,RULES,type Game,type Player,type Table} from '../lib/game';
type State=Omit<Game,'hostHash'|'recent'>&{ownId:string|null;isHost:boolean};
const phaseLabel:any={lobby:'Waiting for players',playing:'Playing',transition:'Round break',tea:'Tea break',ended:'Ended'};
const ruleHelp:any={'Normal UNO':'Play normal UNO. A Draw or Skip card may open one optional question.','Hidden cards':'Agree before the round starts: do not look at your own cards. Ask the table to help you choose. You can keep normal UNO instead.','Optional questions':'Ask a question if you want to talk. Asking and answering are both optional.','Give a card':'You may give one card to another player. The host updates the card counts.','Swap cards':'You may swap cards if both players agree. The host updates the card counts.'};
function Brand(){return <div className="brand"><span className="brandmark">iB</span><span>Icebreaker <b>UNO</b></span><span className="version">V5</span></div>}
function Band({player,compact=false}:{player:Player;compact?:boolean}){const meta=INTERESTS.find(i=>i.id===player.category);const score=player.visibleScore;return <div className={`band ${compact?'compact':''}`} style={{'--band':player.bandColor||'#8893a8','--strength':String(.28+(score??0)/100*.72)} as any}><div className="band-ring"><span>{meta?.symbol||'?'}</span></div><div><strong>{player.name}</strong><span>{meta?.label||'Guest · Answers not saved'}</span>{!compact&&<small>{player.guest?'Guest mode':score===null?'Waiting for shared interests':`Shared interests ${score}%`}{player.pending&&!player.guest?' · Update at the next break':''}</small>}</div></div>}
export default function Home(){
const [code,setCode]=useState(''),[view,setView]=useState('welcome'),[game,setGame]=useState<State|null>(null),[error,setError]=useState(''),[notice,setNotice]=useState(''),[busy,setBusy]=useState(false),[loading,setLoading]=useState(false),[deleted,setDeleted]=useState(false),[tableId,setTableId]=useState('A'),[name,setName]=useState(''),[guest,setGuest]=useState(false),[tags,setTags]=useState<string[]>([]),[consent,setConsent]=useState(false),[selectedPlayer,setSelectedPlayer]=useState(''),[share,setShare]=useState(false),[boardConsent,setBoardConsent]=useState(false),[selectedOption,setSelectedOption]=useState<number|null>(null),[inviteTo,setInviteTo]=useState(''),[newRule,setNewRule]=useState(RULES[0]),[showHelp,setShowHelp]=useState(false),[confirmDelete,setConfirmDelete]=useState(false),[music,setMusic]=useState(false),[matchMsg,setMatchMsg]=useState(''),[drawn,setDrawn]=useState<Record<string,number>>({});
const revision=useRef(-1),matchSeen=useRef(0);
useEffect(()=>{const u=new URL(location.href),c=u.searchParams.get('code')||'';if(c){setCode(c.toUpperCase());setView(u.searchParams.get('view')||'join');setLoading(true)}},[]);
const token=useCallback(()=>{if(typeof window==='undefined'||!code)return '';return view==='player'?localStorage.getItem(`ice-player-${code}`)||localStorage.getItem(`ice-host-${code}`)||'':view==='join'?'':localStorage.getItem(`ice-host-${code}`)||localStorage.getItem(`ice-player-${code}`)||''},[code,view]);
const accept=useCallback((d:any)=>{if(d.revision>=revision.current){revision.current=d.revision;setGame(d.game)}},[]);
const refresh=useCallback(async()=>{if(!code||view==='welcome')return;try{const r=await fetch(`/api/game?code=${encodeURIComponent(code)}`,{headers:{'x-session-token':token()}}),d=await r.json() as any;if(!r.ok){setError(d.error);return}accept(d);setError('')}catch{setError('Connection lost. Trying again.')}finally{setLoading(false)}},[code,view,token,accept]);
useEffect(()=>{void refresh();if(!code||view==='welcome')return;const interval=setInterval(refresh,1800);return()=>clearInterval(interval)},[refresh,code,view]);
function navigate(next:string){setView(next);setSelectedOption(null);setError('');history.replaceState(null,'',next==='welcome'?'/':`/?code=${code}&view=${next}`);revision.current=-1;}
const act=useCallback(async(kind:string,extra:any={})=>{if(busy)return;setBusy(true);setError('');try{const r=await fetch('/api/game',{method:'POST',headers:{'Content-Type':'application/json','x-session-token':token()},body:JSON.stringify({code,kind,requestId:Date.now().toString(36)+Math.random().toString(36).slice(2,10),...extra})}),d=await r.json() as any;if(!r.ok)throw Error(d.error);if(d.deleted){setDeleted(true);setGame(null);localStorage.removeItem(`ice-host-${code}`);localStorage.removeItem(`ice-player-${code}`);return d}if(d.token&&kind==='join'){localStorage.setItem(`ice-player-${code}`,d.token)}accept(d);return d}catch(e:any){setError(e.message);return null}finally{setBusy(false)}},[code,token,accept,busy]);
async function create(demo=false){setBusy(true);setError('');try{const r=await fetch('/api/game',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({kind:'create',demo})}),d=await r.json() as any;if(!r.ok)throw Error(d.error);localStorage.setItem(`ice-host-${d.code}`,d.token);location.href=`/?code=${d.code}&view=host`}catch(e:any){setError(e.message);setBusy(false)}}
async function copy(which:'code'|'join'|'board'){const value=which==='code'?code:`${location.origin}/?code=${code}&view=${which}`;try{await navigator.clipboard.writeText(value);setNotice(which==='code'?'Code copied':'Link copied')}catch{setNotice(value)}setTimeout(()=>setNotice(''),5000)}
const webState=useRef({game:null as State|null,code:''});webState.current={game,code};const navRef=useRef(navigate);navRef.current=navigate;
useEffect(()=>{const context=(document as any).modelContext;if(!context?.registerTool)return;const life=new AbortController();for(const spec of [{name:'read_icebreaker_activity',description:'Read the current round, tables and question. Do not return private interest tags.',inputSchema:{type:'object',properties:{},additionalProperties:false},annotations:{readOnlyHint:true,untrustedContentHint:true},execute:async()=>({code:webState.current.code,tables:webState.current.game?.tables.map(t=>({name:t.name,phase:t.phase,round:t.round,current:t.current,promptStatus:t.prompt?.status})),players:webState.current.game?.players.map(p=>({name:p.name,table:p.tableId,status:p.status}))})},{name:'stage_icebreaker_view',description:'Open the host, shared screen or player view. Do not change the game.',inputSchema:{type:'object',properties:{view:{type:'string',enum:['host','board','player','join']}},required:['view'],additionalProperties:false},execute:async(input:any)=>{if(!['host','board','player','join'].includes(input.view))throw Error('This view is not available.');navRef.current(input.view);await new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)));return {view:input.view}}}])void Promise.resolve(context.registerTool(spec,{signal:life.signal})).catch(()=>{});return()=>life.abort()},[]);
const t=game?.tables.find(t=>t.id===tableId)||game?.tables[0];const ps=game?.players.filter(p=>p.tableId===t?.id&&p.status==='seated')||[];const waiting=game?.players.filter(p=>p.tableId===t?.id&&p.status==='waiting')||[];const me=game?.players.find(p=>p.id===game.ownId)||(game?.isHost?game.players.find(p=>p.id===selectedPlayer&&p.demo):undefined);const ownTable=game?.tables.find(t=>t.id===me?.tableId);
const activeTable=view==='player'&&ownTable?ownTable:t;const target=game?.players.find(p=>p.id===activeTable?.prompt?.target);const q=activeTable?.prompt?.status==='open'?activeTable.prompt:null;const question=q?QUESTIONS[q.question]:undefined;const canAnswer=!!q&&((me?.id===q.target&&me.status==='seated')||(game?.isHost&&(target?.demo||boardConsent)));const pForAnswer=me?.id===q?.target?me:game?.isHost?target:undefined;
useEffect(()=>{if(game?.ended||activeTable?.phase==='ended')setMusic(false);else if(activeTable?.phase==='playing')setMusic(true)},[activeTable?.phase,game?.ended]);
useEffect(()=>{setSelectedOption(null);setShare(false);setBoardConsent(false)},[q?.id,q?.target,q?.question]);
useEffect(()=>{const lm=me?.lastMatch;if(!lm||lm.at<=matchSeen.current)return;matchSeen.current=lm.at;setMatchMsg(`You and ${lm.withName} picked the same thing!`);try{navigator.vibrate?.(200)}catch{}const timer=setTimeout(()=>setMatchMsg(''),1800);return()=>clearTimeout(timer)},[me?.lastMatch?.at]);
function drawQuestion(playerId:string){setDrawn(d=>{const prev=d[playerId];let next=Math.floor(Math.random()*QUESTIONS.length);if(QUESTIONS.length>1)while(next===prev)next=Math.floor(Math.random()*QUESTIONS.length);return {...d,[playerId]:next}})}
const hostAction=(kind:string,extra:any={})=>act(kind,{tableId:activeTable?.id,...extra});
async function answer(kind:string,extra:any={}){const d=await act(kind,{tableId:activeTable?.id,playerId:pForAnswer?.id,promptId:q?.id,boardConsent,...extra});if(d){setSelectedOption(null);setNotice(kind==='answer'?(pForAnswer?.guest?'Your Guest answer was not sent or saved. You may share it out loud.':'Answer done. Bands will update at a suitable break.'):kind==='defer'?'Keep playing. You can answer before your next turn.':'Choice updated.');setTimeout(()=>setNotice(''),5000)}}
if(deleted)return <main className="welcome"><Brand/><section className="finish"><Check size={44}/><h1>Activity data deleted</h1><p>Answers, interest tags and game data have been deleted.</p><a className="button primary" href="/">Back to start</a></section></main>;
if(view==='welcome')return <main className="welcome"><Brand/><div className="entry-grid"><section><div className="eyebrow">Meet your table. Play a game.</div><h1>Start with a game.</h1><p className="lead">Bring your UNO cards and meet new classmates. Choose your seat. Answer only if you want to.</p><button className="primary" onClick={()=>create()} disabled={busy}>{busy?'Creating...':'Create an activity'}</button><button className="text-button" onClick={()=>create(true)} disabled={busy}>Try a demo with 4 players</button><div className="entry-tags">UNO cards <span>+</span> Shared screen <span>+</span> Interest bands</div></section><section className="join-card"><span className="eyebrow">Have a code?</span><h2>Join a table</h2><label>6-character activity code<input value={code} onChange={e=>setCode(e.target.value.toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,6))} placeholder="Example: ABC234" maxLength={6}/></label><button className="secondary" disabled={code.length!==6||busy} onClick={()=>navigate('join')}>Choose how to join</button><p className="quiet">Choose interest tags, or try Guest mode.</p></section></div>{error&&<p role="alert" className="error">{error}</p>}<footer className="entry-footer">Your choice of answers. Your choice of seat. Keep playing.</footer></main>;
const header=<header className="app-header"><a href="/" aria-label="Back to start"><Brand/></a><nav aria-label="Views"><button className={view==='host'?'active':''} onClick={()=>navigate('host')}><SlidersHorizontal size={17}/>Host</button><button className={view==='board'?'active':''} onClick={()=>navigate('board')}><Monitor size={17}/>Shared screen</button><button className={view==='player'||view==='join'?'active':''} onClick={()=>navigate(game?.ownId?'player':'join')}><Users size={17}/>Player</button></nav><button className="code-pill" onClick={()=>copy('code')}>{code}<Copy size={14}/></button></header>;
if(!game)return <>{header}<main className="shell"><section className="panel"><h2>{loading?'Connecting...':'Cannot open this activity'}</h2><p className="quiet">{error||'Please check the code.'}</p><button className="secondary" onClick={refresh}>Try again</button><a className="text-button" href="/">Back to start</a></section></main></>;
if(view==='join')return <>{header}<main className="join-layout"><section><div className="eyebrow">Activity {code}</div><h1>Choose a table. Meet new people.</h1><p className="quiet">Colours show interests. You can choose any table.</p><div className="mode-switch"><button className={!guest?'active':''} onClick={()=>setGuest(false)}>Join with interests</button><button className={guest?'active':''} onClick={()=>setGuest(true)}>Try as a Guest</button></div><form className="panel join-form" onSubmit={async e=>{e.preventDefault();const d=await act('join',{name,guest,tags,consent,tableId});if(d)navigate('player')}}><label>What name would you like to use?<input value={name} onChange={e=>setName(e.target.value)} maxLength={20} placeholder="A nickname is fine" required/></label>{!guest&&<><h3>Choose your interests</h3><p className="quiet">Choose one or more. Your band colour blends all of them together — the more two people share, the closer their colours look. You can still sit anywhere.</p><div className="interest-picks">{INTERESTS.map(i=><button type="button" key={i.id} className={tags.includes(i.id)?'chosen':''} style={{'--band':i.color} as any} onClick={()=>setTags(tags.includes(i.id)?tags.filter(x=>x!==i.id):[...tags,i.id])}><span>{i.symbol}</span>{i.label}{tags.includes(i.id)&&<Check size={16}/>}</button>)}</div><p className="quiet">LinkedIn is not connected. Choose your interests here.</p></>}<h3>Choose a table</h3><div className="table-picks">{game.tables.map(tb=>{const people=game.players.filter(p=>p.tableId===tb.id&&p.status==='seated');return <button type="button" className={tableId===tb.id?'selected':''} key={tb.id} disabled={tb.phase==='ended'} onClick={()=>setTableId(tb.id)}><strong>{tb.name}</strong><span>{people.length} / {tb.capacity} At the table</span><small>{people.length>=tb.capacity?'Full. Wait or choose another table.':tb.phase==='lobby'?'You can join now.':'Join after this round.'}</small><div className="mini-bands">{people.map(p=><span key={p.id} style={{background:p.bandColor||'#8a94ab'}}>{INTERESTS.find(i=>i.id===p.category)?.symbol||'?'}</span>)}</div></button>})}</div>{guest?<p className="privacy-note"><Info size={18}/>Guest answers are not sent or saved. Guest players do not get a shared-interest score.</p>:<label className="checkline"><input type="checkbox" checked={consent} onChange={e=>setConsent(e.target.checked)}/>I agree to use my interests to find shared interests at this table. I choose whether to share each answer. The host deletes the activity data after class.</label>}<button className="primary" type="submit" disabled={busy||!name.trim()||(!guest&&(!tags.length||!consent))}>{busy?'Joining...':guest?'Join as a Guest':'Join with these interests'}</button>{error&&<p role="alert" className="error">{error}</p>}</form></section><aside className="join-aside"><div className="number">01 <span>/ Meet your table</span></div><h2>Shared interests are welcome.<br/>Different interests are welcome too.</h2><p>You can answer, change the question, skip it or invite someone. Skipping a question adds no game penalty.</p><div className="divider"/><h3>Other class activity</h3><p>You can join the activity led by your teacher instead.</p><button className="outline" onClick={()=>{setNotice('Tell your teacher you want to join the other activity. You do not need to sign up here.')}}>Choose the other activity</button></aside></main>{notice&&<div className="toast" role="status">{notice}</div>}</>;
const tableBar=<div className="table-bar"><div className="table-tabs">{game.tables.map(tb=><button key={tb.id} className={activeTable?.id===tb.id?'active':''} onClick={()=>setTableId(tb.id)} disabled={view==='player'&&!!ownTable&&ownTable.id!==tb.id}>{tb.name}<span>{game.players.filter(p=>p.tableId===tb.id&&p.status==='seated').length}</span></button>)}</div><span className="phase"><i className={activeTable?.phase==='playing'?'live':''}/>{phaseLabel[activeTable?.phase||'lobby']}</span><div className="bar-actions"><button className="icon-button" title="How to play" onClick={()=>setShowHelp(!showHelp)}><Info size={20}/></button></div></div>;
const corners=['corner-tl','corner-tr','corner-bl','corner-br'];
const Board=()=>{const tb=activeTable!;const people=game.players.filter(p=>p.tableId===tb.id&&p.status==='seated');return <section className="board-panel"><div className="board-status"><span>{tb.name} · {people.length} players</span><span>Round <b>{tb.round}</b></span><span>{tb.direction===1?'Clockwise':'Counterclockwise'}</span><span>{tb.rule}</span><span>{tb.promptUsed?'Question used this round':'1 question allowed this round'}</span></div><div className="radial-board">
<div className="center-circle"><button className="icon-button music-toggle" type="button" title={music?'Turn music off':'Turn music on'} onClick={()=>setMusic(!music)}>{music?<VolumeX size={16}/>:<Music size={16}/>}</button>{tb.phase==='ended'?<div className="center-idle"><Check size={32}/><h2>{tb.winner?`${tb.winner} has no cards left`:'This game has ended.'}</h2><p>Choose who to talk to or form a group with. You can also leave.</p></div>:tb.phase==='tea'?<div className="center-idle"><Coffee size={32}/><h2>Chat or take a break.</h2><p>Talk about a place you like on campus. You may ask to change tables.</p></div>:question?<div className="center-question"><span className="question-badge">Optional question</span><h2>{question.text}</h2><p>{target?.name}{q?.invited?' has an invitation. Answer or skip it':' can answer, change the question or skip it'}. The game continues.</p></div>:<div className="center-idle"><span className="uno-label">UNO</span><h2>{tb.phase==='lobby'?'Choose your seat. Then start.':tb.phase==='transition'?'Round done. Take a moment to talk.':'Keep playing. Questions can wait.'}</h2><p>{tb.phase==='transition'?'The host can update bands, add waiting players or start a break.':tb.promptUsed?'There will be no more questions this round.':tb.phase==='lobby'?'The host can start when at least 2 players have joined.':'A Draw or Skip card may open an optional question.'}</p></div>}{music&&<iframe className="bg-music-frame" src="https://live.bilibili.com/blanc/27519423" allow="autoplay" title="Background music"/>}</div>
{people.length?people.map((p,i)=>{const isTarget=q?.target===p.id;return <div key={p.id} className={`corner ${corners[i]||''} ${p.id===tb.current?'current':''}`}><div className="corner-content"><Band player={p} compact/><div className="corner-meta"><span>{p.hand} cards</span><span>{tb.done.includes(p.id)?<><Check size={12}/>Done</>:p.id===tb.current?'Their turn':'Waiting'}</span></div><button className="corner-draw" type="button" onClick={()=>drawQuestion(p.id)}><MessageCircleQuestion size={15}/>{drawn[p.id]===undefined?'Draw a question':'Draw another'}</button>{drawn[p.id]!==undefined&&<div className="corner-question"><button className="corner-question-close" type="button" aria-label="Close question" onClick={()=>setDrawn(d=>{const n={...d};delete n[p.id];return n})}><X size={14}/></button><span className="question-badge">Question</span><p>{QUESTIONS[drawn[p.id]].text}</p><ul>{QUESTIONS[drawn[p.id]].options.map((o,idx)=><li key={idx}><span>{String.fromCharCode(65+idx)}</span>{o}</li>)}</ul></div>}{isTarget&&question&&<div className="corner-options"><div className="options-grid">{question.options.map((option,idx)=><button key={idx} className={selectedOption===idx?'selected':''} onClick={()=>setSelectedOption(idx)} disabled={!canAnswer||busy}><span>{String.fromCharCode(65+idx)}</span>{option}</button>)}</div>{game.isHost&&!target?.demo&&me?.id!==q?.target&&<label className="checkline board-consent"><input type="checkbox" checked={boardConsent} onChange={e=>setBoardConsent(e.target.checked)}/>Confirm {target?.name} is using this screen</label>}{canAnswer&&<div className="corner-actions">{pForAnswer?.guest?<p className="privacy-note small">Guest answers stay on this screen only.</p>:<label className="checkline"><input type="checkbox" checked={share} onChange={e=>setShare(e.target.checked)}/>Show my answer, without my name</label>}<div className="corner-action-buttons"><button className="primary" disabled={selectedOption===null||busy} onClick={()=>answer('answer',{option:pForAnswer?.guest?0:selectedOption,share:!pForAnswer?.guest&&share})}>Send</button><button className="outline" disabled={busy} onClick={()=>answer('change_question')}>Change</button><button className="outline" disabled={busy} onClick={()=>answer('pass_question')}>Skip</button><button className="outline" disabled={busy} onClick={()=>answer('defer')}>Later</button></div><div className="invite-line compact"><select aria-label="Invite a player" value={inviteTo} onChange={e=>setInviteTo(e.target.value)}><option value="">Invite someone</option>{game.players.filter(pp=>pp.tableId===activeTable?.id&&pp.status==='seated'&&pp.id!==pForAnswer?.id).map(pp=><option key={pp.id} value={pp.id}>{pp.name}</option>)}</select><button className="outline" disabled={!inviteTo||busy} onClick={()=>answer('invite',{targetId:inviteTo})}>Invite</button></div></div>}</div>}</div></div>}):<div className="empty-seats"><Users size={26}/><p>No players yet. Copy the join link so people can choose this table.</p></div>}
</div><div className="stage-footer"><span><Hand size={15}/>Keep playing with your UNO cards</span><span>Answers are optional. Shared interests do not show who wants to talk.</span></div></section>};
return <>{header}<main className={`shell ${view==='board'?'shared-view':''}`}>
{tableBar}{showHelp&&<section className="help-panel"><h3>How to play</h3><p>Each table plays at its own pace. A skipped turn counts as done. Players who leave are removed from the turn order. There is at most 1 question per round. Answers do not pause the game. Bands update at a natural break. You never have to move because your band changes.</p><p>The screen shows a band for each player. The score compares shared interests at this table. It is a demo, not a rating of you. The host records what happens with the real cards. Explain any new rule before the round starts.</p><p>Two Reverse cards in a row, played by the same two players, cancel out and send the turn back to where it started. That matches real UNO — it is not a bug.</p></section>}
{error&&<div className="error" role="alert">{error}</div>}
{game.ended?<section className="panel finish"><Check size={40}/><h1>Activity done. What next is up to you.</h1><p>Keep chatting, choose a group or leave. Future contact is always your choice.</p>{game.isHost&&<><button className="danger" onClick={()=>setConfirmDelete(true)}><Trash2 size={17}/>Delete activity data after class</button><p className="quiet">This deletes answers, interest tags and all game data.</p></>}</section>:<>
{view==='player'&&(!me||me.status==='left')?<section className="panel"><h2>{me?.status==='left'?'You have left the table.':'Open your player view'}</h2>{game.isHost&&game.players.some(p=>p.demo)?<><p className="quiet">Choose a demo player to try answering questions and changing tables.</p><select aria-label="Choose a demo player" value={selectedPlayer} onChange={e=>setSelectedPlayer(e.target.value)}><option value="">Choose a demo player</option>{game.players.filter(p=>p.demo&&p.status!=='left').map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</select></>:<button className="primary" onClick={()=>navigate('join')}>Choose how to join</button>}</section>:view==='player'&&me&&<section className="my-status panel"><Band player={me}/><div><strong>{me.status==='waiting'?'Waiting to join after this round':`${ownTable?.name} · At the table`}</strong><p className="quiet">{me.status==='waiting'?'You can join when this round ends and a seat is free.':'Changing tables is your choice. A band change never makes you move.'}</p>{me.moveTo&&<p className="quiet">Move to Table {me.moveTo} requested. Please wait for a break.</p>}</div><div className="my-actions"><select aria-label="Choose another table" defaultValue="" onChange={e=>{if(e.target.value)void act('move',{playerId:me.id,destination:e.target.value})}}><option value="">Ask to change tables</option>{game.tables.filter(tb=>tb.id!==me.tableId&&tb.phase!=='ended').map(tb=><option key={tb.id} value={tb.id}>{tb.name}</option>)}</select><button className="outline" disabled={busy} onClick={()=>act('leave',{playerId:me.id})}><LogOut size={15}/>Leave table</button></div>{me.guest&&<button className="text-button" onClick={async()=>{const d=await act('leave',{playerId:me.id});if(d){setGuest(false);setName(me.name);navigate('join')}}}>Leave this seat and join with interests</button>}</section>}
<div className={view==='host'?'workspace-grid':''}><div><Board/>{activeTable?.responses.length? <section className="panel public-responses"><h3>Answers shared by choice</h3>{activeTable.responses.map((r,i)=><span key={i}>{r}</span>)}<p className="quiet">Names are not shown. These answers clear when the next round starts.</p></section>:null}
{view==='host'&&<section className="panel activity-log"><h3>Activity log</h3>{game.log.slice(0,7).map((l,i)=><div key={i}><time>{new Date(l.time).toLocaleTimeString('en-AU',{hour:'2-digit',minute:'2-digit'})}</time><span>{l.text}</span></div>)}</section>}</div>
{view==='host'&&<aside className="host-panel panel"><div className="section-head"><h2>Host controls</h2><SlidersHorizontal size={19}/></div>{!game.isHost?<p className="quiet">Open Host on the device that created this activity.</p>:<><p className="quiet">Record what happens with the real cards. Do not wait for answers.</p>{['lobby','transition','tea'].includes(activeTable!.phase)?<><label>Rule for the next round<select value={newRule} onChange={e=>setNewRule(e.target.value)} disabled={activeTable?.phase==='lobby'}>{RULES.map(r=><option key={r}>{r}</option>)}</select></label><p className="quiet rule-help">{ruleHelp[activeTable?.phase==='lobby'?RULES[0]:newRule]}</p>{activeTable?.phase!=='lobby'&&<button className="outline full" onClick={()=>setNewRule(RULES[1+Math.floor(Math.random()*(RULES.length-1))])}><Shuffle size={16}/>Pick a random rule</button>}<button className="primary full" disabled={busy} onClick={()=>{if(activeTable?.phase==='lobby')setMusic(true);hostAction(activeTable?.phase==='lobby'?'start':activeTable?.phase==='tea'?'resume':'next_round',{rule:activeTable?.phase==='lobby'?RULES[0]:newRule})}}><Play size={17}/>{activeTable?.phase==='lobby'?'Start this table':activeTable?.phase==='tea'?'End break and play':'Start next round'}</button></>:activeTable?.phase==='playing'?<><div className="current-player"><span className="quiet">Current turn</span><strong>{game.players.find(p=>p.id===activeTable.current)?.name}</strong></div><div className="event-buttons">{[{id:'play',label:'Play a card',mark:'1'},{id:'draw',label:'Draw 1',mark:'+'},{id:'skip',label:'Skip',mark:'⊘'},{id:'draw2',label:'Draw 2',mark:'+2'},{id:'draw4',label:'Draw 4',mark:'+4'},{id:'reverse',label:'Reverse',mark:'↻',hint:'Flips the play direction. Two reverses in a row by the same two players cancel out and send the turn back to where it started — that matches real UNO.'},{id:'pass',label:'End turn',mark:'✓',hint:"For when they couldn't play or draw. Moves on without changing their card count."}].map(e=><button disabled={busy} key={e.id} title={(e as any).hint} onClick={()=>hostAction('event',{event:e.id})}><b>{e.mark}</b>{e.label}</button>)}</div></>:<p className="quiet">This table has finished. You can end the activity for everyone.</p>}
<div className="host-divider"/><label className="toggleline"><input type="checkbox" checked={activeTable?.conversation||false} onChange={e=>hostAction('conversation',{value:e.target.checked})}/><span>Players are talking<small>Keep the current bands. Update them later.</small></span></label><button className="outline full" disabled={busy||activeTable?.conversation||!['transition','tea','lobby'].includes(activeTable!.phase)} onClick={()=>hostAction('feedback')}><RotateCcw size={16}/>Update bands at a break</button><button className="outline full" disabled={busy||activeTable?.phase==='ended'||activeTable?.phase==='tea'} onClick={()=>hostAction('tea')}><Coffee size={17}/>{activeTable?.teaRequested?'Break planned after this round':'Plan a tea break'}</button>
{waiting.length>0&&<div className="queue"><h3>{waiting.length} players waiting</h3>{waiting.map(p=><p key={p.id}>{p.name} <small>{p.guest?'Guest':'Joined with interests'}</small></p>)}<span className="quiet">Add waiting players when the next round starts, if seats are free.</span></div>}
<details className="hand-editor"><summary>Edit card counts</summary>{ps.map(p=><label key={p.id}>{p.name}<input type="number" aria-label={`${p.name}card count`} min={0} max={60} defaultValue={p.hand} key={`${p.id}-${p.hand}`} onBlur={e=>{if(Number(e.target.value)!==p.hand)void hostAction('hand',{targetId:p.id,hand:Number(e.target.value)})}}/></label>)}</details>
<div className="host-divider"/><button className="outline full" onClick={()=>copy('join')}><Copy size={16}/>Copy the player link</button><button className="outline full" onClick={()=>copy('board')}><Monitor size={16}/>Copy the shared-screen link</button><button className="danger-text" disabled={busy} onClick={()=>{setMusic(false);hostAction('end')}}>End the activity for everyone</button></>}</aside>}
</div></>}
<footer className="app-footer"><span>Colour = interest. Darker band = more shared interests at this table.</span><button className="text-button" onClick={()=>setShowHelp(!showHelp)}>How to play</button></footer>
</main>{matchMsg&&<div className="match-flash" style={{'--flash':me?.bandColor||'#6d52df'} as any}><span>{matchMsg}</span></div>}{notice&&<div className="toast" role="status">{notice}</div>}{confirmDelete&&<div className="modal-backdrop"><section className="modal" role="dialog" aria-modal="true" aria-labelledby="delete-title"><Trash2 size={30}/><h2 id="delete-title">Delete this activity data?</h2><p>Delete answers, interest tags and game data. No one can open this activity after that.</p><div className="response-actions"><button className="outline" onClick={()=>setConfirmDelete(false)}>Cancel</button><button className="danger" disabled={busy} onClick={()=>act('delete')}>Delete data</button></div></section></div>}</>;
}
